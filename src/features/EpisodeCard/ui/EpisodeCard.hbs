<div class='episode__item episode-card'>
  <div class='episode__card'>
    <div class='series__episodes__image'>
      <img src='{{poster}}' alt='episode' />
    </div>
  </div>
  <div class='episode__info'>
    <div class='episode__description'>
      <h4 class='episode__title'>{{title}}</h4>
      <p class='episode__genre'>{{description}}</p>
    </div>
  </div>
</div>