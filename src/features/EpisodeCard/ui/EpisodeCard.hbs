<div class="episode__item">
    <a class='episode__card' href='/a/{{id}}' data-navigate>
        <div class='series__episodes__image'>
            <img src='{{poster}}' alt='episode' />
        </div>
    </a>
    <div class='episode__info'>
        <h4 class='episode__title'>S{{season_number}}E{{episode_number}}</h3>
        <div class="episode__description">
            <h4 class='episode__title'>{{title}}</h3>
            <p class='episode__genre'>{{plot_summary}}</p>
        </div>
    </div>
</div>