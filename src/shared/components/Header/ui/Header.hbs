<header class='header container'>
    <div class='header__inner'>
        <a class='header__logo logo' href='/' data-navigate id='homeLink'>
        </a>
<div class="header__search-wrapper">
            <input 
                class='header__input input' 
                type='text' 
                placeholder='Search films, series, actors...' 
                id="searchInput"
            />

            <div class="header__search-dropdown" id="searchDropdown">
                {{#if searchResults}}
                    {{#if searchResults.actors}}
                        {{#each searchResults.actors}}
                            <div class="header__search-section">
                                {{#if @first}}
                                    <div class="header__search-section-title">People</div>
                                {{/if}}

                                <div class="header__search-item actor" data-navigate="/actor/{{id}}">
                                    <img 
                                        src="{{#with image_urls}}{{#if this.[0]}}{{this.[0]}}{{else}}https://via.placeholder.com/48{{/if}}{{/with}}" 
                                        alt="{{name}}"
                                    />
                                    <div class="header__search-item-info">
                                        <div class="header__search-item-title">{{name}}</div>
                                    </div>
                                </div>
                            </div>
                        {{/each}}
                    {{/if}}

                    {{#if searchResults.medias}}
                        {{#each searchResults.medias}}
                            <div class="header__search-section">
                                {{#if @first}}
                                    <div class="header__search-section-title">Titles</div>
                                {{/if}}

                                <div class="header__search-item" data-navigate="/film/{{id}}">
                                    <img 
                                        src="{{#with posters}}{{#if this.[0]}}{{this.[0]}}{{else}}https://via.placeholder.com/40x60{{/if}}{{/with}}" 
                                        alt="{{title}}"
                                    />
                                    <div class="header__search-item-info">
                                        <div class="header__search-item-title">{{title}}</div>
                                        <div class="header__search-item-subtitle">
                                            {{#if rating}}★ {{rating}}{{/if}}
                                            {{#if release_date}}
                                                {{#with (split release_date "-")}}
                                                    {{#if this.[0]}} | {{this.[0]}}{{/if}}
                                                {{/with}}
                                            {{/if}}
                                            {{#if duration_minutes}} | {{duration_minutes}} min{{/if}}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {{/each}}
                    {{/if}}

                    {{#unless searchResults.actors}}
                        {{#unless searchResults.medias}}
                            <div class="header__search-section-title">No results found</div>
                        {{/unless}}
                    {{/unless}}
                {{/if}}
            </div>
        </div>

        <div class='header__auth'>
            {{#if isAuthorized}}
                <div class="header__auth">
                    <a href="/account/settings" data-navigate="/account/settings" class="header__user">
                    {{#if user.avatar_url}}
                    <img src="{{user.avatar_url}}" alt="{{user.username}}" class="header__avatar" />
                    {{else}}
                    <div class="header__avatar header__avatar--placeholder"></div>
                    {{/if}}
                    <span class="header__username" data-navigate="/account/settings">{{user.username}}</span>
                    </a>
                </div>
                <button
                    class='header__auth-button button'
                    type='button'
                    id='logOutBtn'
                >Log out</button>
            {{else}}
                <button
                    class='header__auth-button button'
                    type='button'
                    data-navigate='/signup'
                >Sign up</button>
                <button
                    class='header__auth-button button'
                    type='button'
                    data-navigate='/login'
                >Log in</button>
            {{/if}}
        </div>
    </div>
    <nav class='header__menu'>
        <ul class='header__menu-list'>
            <li class='header__menu-item'>
                <a
                    class='header__menu-link'
                    href='/films'
                    data-navigate
                    id='homeLink'
                >
                    <h4 class='header__menu-title'>Films</h4>
                </a>
            </li>
            <li class='header__menu-item'>
                <a
                    class='header__menu-link'
                    href='/series'
                    data-navigate
                    id='homeLink'
                >
                    <h4 class='header__menu-title'>Series</h4>
                </a>
            </li>
        </ul>
    </nav>
</header>